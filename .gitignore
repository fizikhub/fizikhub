# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# generated by @ducanh2912/next-pwa during production builds
/public/sw.js
/public/workbox-*.js
/public/fallback-*.js

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# temp files
/temp_repos
.agent

# lighthouse reports
lh*.json
/lhci-report

# typescript
*.tsbuildinfo
next-env.d.ts

# build analysis artifacts
bundle_*.json
smp.json
*.log
!README.md

# one-off dev/debug scripts (keep scripts/ for sanctioned tools)
check_*.js
test-*.js
list_*.js
sync_*.js
